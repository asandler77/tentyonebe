# Azure OpenAI configuration for "21 Questions" game
# Copy this file to .env and fill in your values

# Azure OpenAI Endpoint (URL of your resource)
# Format: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# API key for Azure OpenAI access
# Can be found in Azure Portal -> Your OpenAI resource -> Keys and Endpoint
AZURE_OPENAI_API_KEY=your-api-key-here

# Name of deployed model in Azure OpenAI
# Usually gpt-4, gpt-35-turbo or another model you deployed
AZURE_OPENAI_MODEL_NAME=gpt-4

# Additional settings (optional)
# Maximum number of questions in the game
MAX_QUESTIONS=21

# Port for running the application
PORT=5000

# Debug mode (true/false)
DEBUG=false
